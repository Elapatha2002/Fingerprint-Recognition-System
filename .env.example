# Supabase restricted runtime connection created by setup_supabase.py
DATABASE_URL=postgresql://fingerprint_demo_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# PBKDF2 value created by setup_supabase.py; never store a plain password here
FRS_ACCESS_PASSWORD_HASH=pbkdf2_sha256$250000$SALT$HASH

MATCH_THRESHOLD=0.55

# Local Windows: auto or direct. Hosted server: bridge.
MANTRA_SENSOR_TRANSPORT=auto
MANTRA_BRIDGE_URL=http://127.0.0.1:8765
